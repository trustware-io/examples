# Browser-visible configuration. Never put a privileged/server API key here.
NEXT_PUBLIC_TRUSTWARE_API_KEY=
NEXT_PUBLIC_ENABLE_EXECUTION=false
NEXT_PUBLIC_TRUSTWARE_FROM_CHAIN=8453
NEXT_PUBLIC_TRUSTWARE_TO_CHAIN=8453
NEXT_PUBLIC_TRUSTWARE_FROM_TOKEN=0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE
NEXT_PUBLIC_TRUSTWARE_TO_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_TRUSTWARE_FROM_AMOUNT=1000000000000000
# Blank recipient resolves to the connected EOA. Source address is read from the wallet.
NEXT_PUBLIC_TRUSTWARE_TO_ADDRESS=
